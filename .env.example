# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty for local development: an embedded PGlite database
# is created in ./.data/pglite. In production use the Supabase *pooler*
# connection string (Transaction mode, port 6543) for the web app.
#
# Supabase: Project → Connect → copy the connection string and put your DB
# password in place of [YOUR-PASSWORD]. The app uses plain PostgreSQL, so the
# Supabase anon / service_role API keys are NOT needed.
# Percent-encode special characters in the password (@ → %40, : → %3A, / → %2F).
#
# Web app / dev server: Transaction pooler, port 6543
#   postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# CLI scripts (pipeline, migrations, seed): Session pooler, port 5432 (same host). When set,
# scripts use it instead of DATABASE_URL. In GitHub Actions it is the WORKER_DATABASE_URL secret.
#   postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
WORKER_DATABASE_URL=
# With both set you can run `npm run dev` and `npm run pipeline` together.
# Max connections per server instance (keep small on Vercel with the pooler).
DATABASE_POOL_MAX=3

# --- Uploaded files (content manager) ----------------------------------------
# Optional. Without these, uploaded PDFs are stored in the database (max 10 MB each),
# which works on Vercel. With them, files go to a private Supabase Storage bucket
# (create the bucket first). The service-role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=notice-files

# --- Site ---------------------------------------------------------------------
# Public base URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pipeline -----------------------------------------------------------------
# Identifies our crawler to government sites; include a contact URL or email.
CRAWLER_USER_AGENT=GovJobFinderBot/1.0 (+https://example.com/about#crawler)
# Optional. When set, Claude fills notice fields the deterministic extractors miss.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. Set another model id here if you want a different cost/quality trade-off.
ANTHROPIC_MODEL=
# Optional. Lets "Run full pipeline now" in the admin dispatch the GitHub workflow.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=owner/govjobfinder
# Branch the workflow is dispatched on (default: master).
GITHUB_DISPATCH_REF=master

# --- Optional visitor login (leave blank to hide login entirely) ------------------
# Saved jobs are kept in the browser for everyone; logged-in visitors also get them on every device.
# Set NEXT_PUBLIC_SITE_URL (above) to your real https domain first: it builds the Google redirect URL.
#
# Google: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
#   Authorised redirect URI:  <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram: create a bot with @BotFather. Username without the @. The webhook secret is any long random
# string you choose (letters, digits, _ and - only). After deploying run: npm run telegram:webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
