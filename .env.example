# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty for local development: an embedded PGlite database
# is created in ./.data/pglite. In production use the Supabase *pooler*
# connection string (Transaction mode, port 6543) for the web app.
DATABASE_URL=

# --- Site ---------------------------------------------------------------------
# Public base URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pipeline -----------------------------------------------------------------
# Identifies our crawler to government sites; include a contact URL or email.
CRAWLER_USER_AGENT=GovJobFinderBot/1.0 (+https://example.com/about#crawler)
# Optional. When set, Claude fills notice fields the deterministic extractors miss.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. Set another model id here if you want a different cost/quality trade-off.
ANTHROPIC_MODEL=
# Optional. Lets "Run full pipeline now" in the admin dispatch the GitHub workflow.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=owner/govjobfinder
